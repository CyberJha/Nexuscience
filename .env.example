# NEXUSCIENCE Environment Configuration
# Copy this file to .env.local and add your secret API keys

# Required: Groq API Key (Sign up at https://console.groq.com)
GROQ_API_KEY=

# Required for Web Search: Tavily API Key (Sign up at https://app.tavily.com)
TAVILY_API_KEY=

# Optional: Override default Groq model (defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
